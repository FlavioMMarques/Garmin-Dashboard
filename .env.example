# Gere em https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=
# Opcional: https://personal.connectapi.garmin.cn para contas da China
GARMIN_BASE_URL=https://personal.connectapi.garmin.com
PORT=8787
# Opcional, para "Pergunte" (IA): chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: outro modelo do Gemini (padrão gemini-3.8-flash)
GEMINI_MODEL=
